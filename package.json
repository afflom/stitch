{
  "name": "@syntra-labs/stitch",
  "version": "0.2.0",
  "description": "Model-driven recoverable objects and replayable computation across changing peers",
  "type": "module",
  "main": "src/layer1-uor/index.js",
  "scripts": {
    "test": "node scripts/check-model.mjs && node scripts/check-facets.mjs --check && node scripts/check-product.mjs --check && node --test scripts/*-tests.mjs tests/*.test.js && node tests/run_all.js",
    "serve": "python3 -m http.server 8080",
    "model:write": "node scripts/check-model.mjs --write",
    "model:check": "node scripts/check-model.mjs",
    "test:independent": "python3 scripts/verify-custody.py",
    "product:write": "node scripts/check-facets.mjs --write && node scripts/check-product.mjs --write",
    "product:check": "node scripts/check-facets.mjs --check && node scripts/check-product.mjs --check",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
    "facets:write": "node scripts/check-facets.mjs --write",
    "facets:check": "node scripts/check-facets.mjs --check",
    "evidence:check": "node scripts/check-source-evidence.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Syntra-Labs/stitch.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "prism-code": "0.7.2"
  }
}
